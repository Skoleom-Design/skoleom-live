# Database — PostgreSQL (Supabase en prod, ou via `docker compose up -d` en local,
# voir docker-compose.yml — port hote 5488). Retirer DB_HOST pour utiliser SQLite en
# local a la place (aucune config requise). DB_SSL=false pour un Postgres local sans TLS
# (Supabase et la plupart des hebergeurs geres l'exigent, donc actif par defaut).
DB_HOST=127.0.0.1
DB_PORT=5488
DB_USERNAME=postgres
DB_PASSWORD=skoleom_dev_pw
DB_NAME=skoleom_live
DB_SSL=false

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# AWS S3
AWS_REGION=eu-west-3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=skoleom-live
S3_BUCKET_DOMAIN=skoleom-live.s3.amazonaws.com

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Commission rate (0.15 = 15%)
COMMISSION_RATE=0.15

# App
API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_STRIPE_PK=pk_test_...
NODE_ENV=development
PORT=3000

# Instagram ("Instagram API with Instagram Login")
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/instagram/callback

# LiveKit (diffusion video reelle des lives) — cree un compte gratuit sur https://livekit.io,
# recupere ces 3 valeurs dans Settings > Keys. Sans ça, l'aperçu camera reste local uniquement
# (aucun spectateur ne recoit la video), le reste (chat, encheres, cadeaux) fonctionne quand meme.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-project.livekit.cloud
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
